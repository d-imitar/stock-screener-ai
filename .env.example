# ===============================================================================
# STOCK SCREENER CONFIGURATION
# ===============================================================================
# Copy this file to .env and fill in your actual API keys
# 
# IMPORTANT: Never commit .env to version control!
# Add .env to .gitignore to prevent accidental exposure of API keys.
# ===============================================================================

# ===============================================================================
# 1. PRIMARY MODEL SELECTION
# ===============================================================================
# Choose which AI model to use for equity research analysis
# Options: gpt-4-turbo, claude-3-haiku, moonshot, baichuan-4-finance
# 
# RECOMMENDATION: Start with "moonshot" for best balance of cost and quality
ANALYSIS_MODEL=moonshot

# ===============================================================================
# 2. API KEYS (Choose based on selected model)
# ===============================================================================

# --- OpenAI (for GPT-4 Turbo) ---
# Get your key from: https://platform.openai.com/api-keys
# Cost: $0.09 per stock analysis
# Quality: Excellent (10/10)
# Leave blank if not using GPT-4 Turbo
OPENAI_API_KEY=

# --- Anthropic (for Claude 3 Haiku) ---
# Get your key from: https://console.anthropic.com/
# Cost: $0.003 per stock analysis
# Quality: Very Good (8/10)
# Leave blank if not using Claude 3 Haiku
ANTHROPIC_API_KEY=

# --- Moonshot/Kimi AI (for Moonshot model) ---
# Get your key from: https://platform.moonshot.cn/
# Cost: $0.001 per stock analysis
# Quality: Excellent (9/10)
# Documentation: https://platform.moonshot.cn/docs
MOONSHOT_API_KEY=

# --- Baichuan (for Baichuan 4 Finance) ---
# Get your key from: https://platform.baichuan-ai.com/
# Cost: $0.0005 per stock analysis (CHEAPEST)
# Quality: Good (8/10)
# Documentation: https://platform.baichuan-ai.com/docs
BAICHUAN_API_KEY=

# ===============================================================================
# 3. SEC EDGAR CONFIGURATION
# ===============================================================================
# Email for SEC EDGAR API (used for rate limiting and identification)
# Required for downloading SEC reports
# Example: your.email@example.com
SEC_EDGAR_USERNAME=research@stockscreener.com

# ===============================================================================
# 4. STOCK UNIVERSE SETTINGS
# ===============================================================================
# Number of NASDAQ 100 stocks to screen
# Set to 100 for full NASDAQ 100, or lower for testing
# Recommended: 100 (full set) or 20 (for testing)
NASDAQ_100_LIMIT=100

# ===============================================================================
# 5. REPORT CACHING SETTINGS
# ===============================================================================
# Number of days to cache downloaded SEC reports
# Reports won't be re-downloaded if cache is still valid
# Default: 30 days (adjust based on how often reports update)
REPORT_CACHE_DAYS=30

# ===============================================================================
# 6. ANALYSIS SETTINGS
# ===============================================================================
# Temperature for AI model responses
# 0.0 = deterministic (same response every time)
# 0.7 = balanced (good for research)
# 1.0 = random/creative (less predictable)
# Recommended: 0.7
ANALYSIS_TEMPERATURE=0.7

# Maximum tokens for AI response
# Higher = longer, more detailed responses
# Recommended: 2000 (balance between detail and cost)
ANALYSIS_MAX_TOKENS=2000

# ===============================================================================
# 7. COST ESTIMATION REFERENCE
# ===============================================================================
# Use these to estimate costs for your screening needs:
#
# BAICHUAN 4 FINANCE (Ultra-cheap):
#   - 100 stocks: $0.05/month
#   - 1000 stocks: $0.50/month
#   - S&P 500: $2.50/month
#   - Annual: $6 for S&P 500
#
# MOONSHOT (Recommended):
#   - 100 stocks: $0.10/month
#   - 1000 stocks: $1.00/month
#   - S&P 500: $5.00/month
#   - Annual: $12 for S&P 500
#
# GPT-4 TURBO (Premium):
#   - 100 stocks: $9.00/month
#   - 1000 stocks: $90.00/month
#   - S&P 500: $450.00/month
#   - Annual: $1,080 for S&P 500
#
# HYBRID STRATEGY (Recommended for professionals):
#   - Screening with Baichuan: $0.05/month (100 stocks)
#   - Detailed analysis with Moonshot: $0.10/month (100 stocks)
#   - Premium review with GPT-4: $0.45/month (top 5)
#   - Total: ~$27/month for comprehensive screening

# ===============================================================================
# 8. QUICK START GUIDE
# ===============================================================================
# 
# STEP 1: Choose your model
# - For budget: ANALYSIS_MODEL=baichuan-4-finance
# - For balanced: ANALYSIS_MODEL=moonshot (RECOMMENDED)
# - For premium: ANALYSIS_MODEL=gpt-4-turbo
#
# STEP 2: Get the API key
# - Visit the provider's website (links above)
# - Generate an API key
# - Paste it in the corresponding field above
#
# STEP 3: Set SEC EDGAR email
# - Any valid email works
# - Used by SEC for rate limiting and tracking
#
# STEP 4: Save and test
# - Save this file as .env in the project root
# - Run: python config.py
# - Check for "✓" marks to verify configuration
#
# STEP 5: Run the screener
# - python main.py
#
# That's it! The screener will use your selected model.

# ===============================================================================
# 9. SECURITY BEST PRACTICES
# ===============================================================================
#
# ✓ DO:
#   - Add .env to .gitignore
#   - Never commit .env to version control
#   - Rotate API keys periodically
#   - Use different keys for different environments
#   - Monitor API usage in provider dashboards
#
# ✗ DON'T:
#   - Hardcode API keys in source code
#   - Share .env file with others
#   - Use the same key for multiple projects
#   - Post your .env file anywhere public
#   - Leave sensitive keys in git history
